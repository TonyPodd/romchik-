# Mafia AI Backend Configuration

# ============================================================================
# CompreFace Configuration (Professional Face Recognition)
# ============================================================================
# Set to true to use CompreFace instead of built-in ONNX face recognition
COMPREFACE_ENABLED=false

# CompreFace server URL (default: http://localhost:8001)
COMPREFACE_URL=http://localhost:8001

# CompreFace API Key (get from CompreFace UI after creating Recognition Service)
# Steps to get API key:
# 1. Open http://localhost:8001 and login
# 2. Create Application (e.g., "Mafia Game")
# 3. Create Recognition Service (e.g., "Player Recognition")
# 4. Click the key icon next to the service to copy API key
COMPREFACE_API_KEY=your_api_key_here

# ============================================================================
# Face Recognition Backend Selection
# ============================================================================
# Options: AUTO, ONNX, LANDMARKS, COMPREFACE
# AUTO: Try ONNX, fallback to LANDMARKS if ONNX fails
# COMPREFACE: Use CompreFace (requires COMPREFACE_ENABLED=true)
FACE_BACKEND=AUTO

# Face similarity threshold (0.0-1.0, higher = more strict matching)
# ONNX: 0.52 (default), CompreFace: 0.70 (default), LANDMARKS: 0.85 (default)
FACE_SIM_THRESHOLD=0.52

# ============================================================================
# Camera Configuration
# ============================================================================
CAMERA_INDEX=0
CAM_WIDTH=1280
CAM_HEIGHT=720
GESTURE_FPS=30

# OpenCV backend (Windows only: MSMF, DSHOW, ANY, AUTO)
OPENCV_BACKEND=AUTO

# Force MJPEG format (0=off, 1=on)
FORCE_MJPEG=0

# ============================================================================
# Game Configuration
# ============================================================================
TABLE_Y_RATIO=0.80

# ============================================================================
# Development
# ============================================================================
# Enable debug logging
DEBUG=false
